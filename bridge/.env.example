# Random secret your webapp/Foundry sends as `Authorization: Bearer <BRIDGE_TOKEN>`
BRIDGE_TOKEN=change-me-to-a-long-random-string

# COROS region base URL (no trailing slash). EU / US / CN.
COROS_BASE=https://mcpeu.coros.com

# Dynamically-registered OAuth client (we already created one).
# Re-register by running `node register.js` if needed.
COROS_CLIENT_ID=a9a30d7b-0baf-42d2-8c00-6ecbd212830b

# Where the bridge listens
PORT=8787

# Public URL of the bridge (used as OAuth redirect_uri). Must match what the
# OAuth client was registered with. For local dev, use http://localhost:8787
PUBLIC_URL=http://localhost:8787
